# HealthyCropping FastAPI Backend Environment Configuration
# Copy this file to api/.env and fill in the values before running locally.
# Never commit api/.env or any service account JSON files.

# Application environment: development | staging | production
ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Firebase Admin SDK
# Path to the downloaded Firebase service account JSON file (keep outside git or in ignored path)
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Google Gemini API (Google AI Studio free tier)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary (Signed photo uploads, max 1280px per-user folder)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# RAG (POST /explanations is limited to 20 requests per user per hour, fixed in code)
# Built by scripts/fetch_agronomic_docs.py + scripts/build_rag_index.py (git-ignored)
RAG_INDEX_PATH=./.cache/rag/index.json
