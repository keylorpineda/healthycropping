{
  "expo": {
    "name": "HealthyCropping",
    "slug": "healthycropping",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "healthycropping",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B3B2B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.keylorpineda.healthycropping"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B3B2B"
      },
      "package": "com.keylorpineda.healthycropping",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "./plugins/withTfliteModels"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
