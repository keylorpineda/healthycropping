# HealthyCropping Expo Android App Environment Configuration
# Copy this file to app/.env and fill in the values before building.
# Note: EXPO_PUBLIC_* variables are embedded into the client bundle. Never put
# private API secrets (like Cloudinary API secret or Gemini API key) here.

# FastAPI Backend Base URL (Render URL in production or local IP on LAN for dev)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Firebase Client Web/App Configuration (for Firebase Auth Email/Password only)
# The app never accesses Firestore directly; all sync goes through the FastAPI backend.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:android:0000000000000000

# Cloudinary Public Cloud Name (upload signature is issued by the FastAPI server)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
