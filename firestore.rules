rules_version = '2';

// The Android app never reads or writes Firestore directly. All data access goes
// through api/, which uses the Firebase Admin SDK (not subject to these rules)
// and scopes every query to the verified caller's ownerUid.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
